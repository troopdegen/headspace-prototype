# Nebius Token Factory (OpenAI-compatible). Get a key at https://tokenfactory.nebius.com
NEBIUS_API_KEY=
# Optional overrides
# NEBIUS_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Linkup web search for the support agent (optional). Get a key at https://app.linkup.so
LINKUP_API_KEY=
# LINKUP_DEPTH=fast            # flash | fast | standard | deep

# Persistence: either naming works.
# - KV_REST_API_URL / KV_REST_API_TOKEN are injected automatically when you add
#   the Upstash integration from the Vercel dashboard (Storage tab) — no need to
#   set these by hand in production.
# - UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN if you point at an Upstash
#   database directly (e.g. for local dev without linking a Vercel project).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# K_FLOOR=5                    # minimum cohort size before a community cluster is shown
